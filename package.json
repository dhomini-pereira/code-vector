{
  "name": "code-vector",
  "version": "1.0.0",
  "description": "Software para indexar repositórios utilizando I.A. de Embeddings - RAG",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "npm run typecheck && swc src --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write ."
  },
  "keywords": [],
  "author": "Dhomini Pereira",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-glob": "^3.3.3",
    "ollama": "^0.6.4",
    "pg": "^8.23.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "allowScripts": {
    "esbuild": true,
    "tree-sitter@0.25.1": true,
    "tree-sitter-java@0.23.5": true,
    "tree-sitter-javascript@0.25.0": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-json@0.24.8": true,
    "tree-sitter-python@0.25.0": true,
    "tree-sitter-rust@0.24.0": true,
    "tree-sitter-typescript@0.23.2": true
  }
}
